# Local Vite development proxy. Start the portal's local proxy server as well.
ADMIN_PROXY_TARGET=http://localhost:8787

# Vercel serverless proxy settings. Add these to Vercel as server-side
# Environment Variables; do not prefix the token with VITE_.
ADMIN_API_URL=https://api.example.com/api
ADMIN_API_TOKEN=replace-with-admin-api-token
