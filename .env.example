# Copy this file to .env.
# Leave API_BASE_URL empty, or set USE_MOCK_API=true, to simulate the API on device.
# Do not put API keys, passwords, or access tokens in this file.
#
# Local server (npm run server):
#   phone on the same Wi-Fi: http://<your-lan-ip>:8787
#   Android emulator:        http://10.0.2.2:8787

API_BASE_URL=
USE_MOCK_API=true
